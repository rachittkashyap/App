# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/training-platform

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis (used from Phase 9 onward)
REDIS_URL=redis://localhost:6379

# SMTP (used from Phase 2/9 onward)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Training Platform <no-reply@example.com>"

# Payment Gateway (used from Phase 7 onward)
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Cloud Storage (used from Phase 4 onward)
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
